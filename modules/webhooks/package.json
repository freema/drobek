{
  "name": "drobek-module-webhooks",
  "version": "1.0.0",
  "private": true,
  "description": "Built-in drobek platform module: incoming webhooks \u2014 a signed POST from another service is verified with a secret set in the dashboard and stored as a record in a data collection the app reads with drobek.data.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@drobek/apps": "workspace:*",
    "@drobek/db": "workspace:*",
    "@drobek/modules": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22",
    "drobek-module-data": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
