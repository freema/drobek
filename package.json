{
  "name": "drobek",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "express@4>qs": "^6.16.0"
    }
  },
  "scripts": {
    "build:packages": "pnpm -r --filter '!server' run build",
    "typecheck": "pnpm -r --no-sort run typecheck",
    "doc-lint": "node scripts/doc-lint.mjs",
    "knip": "knip --no-progress",
    "lint": "pnpm --filter server lint",
    "lint:fix": "pnpm --filter server lint:fix",
    "test": "pnpm -r --workspace-concurrency=1 run test:run && pnpm -r --workspace-concurrency=1 --filter './examples/*' run test",
    "db:generate": "pnpm --filter @drobek/db db:generate",
    "db:migrate": "pnpm --filter @drobek/db db:migrate"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "knip": "^6.38.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.9.3"
  }
}
