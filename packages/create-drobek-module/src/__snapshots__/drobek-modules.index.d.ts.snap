/** Everything a route handler gets — scoped to ONE app and ONE module. */
interface ModuleContext<Config = unknown> extends ModuleServices {
    app: HookApp;
    module: string;
    principal: Principal;
    /** This app's effective config (defaults + what was set). */
    config: Config;
    /**
