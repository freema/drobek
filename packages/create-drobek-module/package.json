{
  "name": "create-drobek-module",
  "version": "1.0.0",
  "private": false,
  "description": "Scaffold a drobek platform module: npm create drobek-module@latest <name> — routes, SDK, a migration, SKILL.md, vitest + PGlite tests and the checkSkill gate.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freema/drobek.git",
    "directory": "packages/create-drobek-module"
  },
  "type": "module",
  "bin": {
    "create-drobek-module": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "template",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22",
    "drizzle-orm": "^0.45.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
