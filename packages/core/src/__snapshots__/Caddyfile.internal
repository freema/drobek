# drobek Caddyfile — GENERATED by `task caddy:config` from the environment.
# Do not edit by hand: change .env and re-run the task. Contains no secrets.
# TLS mode: internal — Caddy's local CA for every site (development only; trust its root to avoid warnings)

{
	# The root CA lives in the caddy_data volume; never touch the host trust store.
	skip_install_trust
}

(drobek) {
	# Internal endpoints (the TLS ask) are for Caddy only — never public.
	@internal path /api/internal /api/internal/*
	handle @internal {
		respond 404
	}
	handle {
		reverse_proxy drobek:3000 {
			# Host passes through untouched (drobek dispatches on it). X-Real-IP is
			# REPLACED with the TCP peer, so a client-sent value never reaches drobek
			# (run drobek with TRUST_PROXY=x-real-ip).
			header_up X-Real-IP {remote_host}
		}
	}
}

# Dashboard, OAuth and MCP (PUBLIC_APP_URL).
localhost {
	tls internal
	import drobek
}

# Every app host: <slug>, <slug>--preview, <slug>--v<N> (APPS_DOMAIN).
*.apps.localhost {
	tls internal
	import drobek
}
