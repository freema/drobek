# drobek — local dev environment (docker compose reads this file for ${VAR} interpolation,
# Taskfile.yml loads it via dotenv). Copy to `.env` and adjust. NEVER commit `.env`.
# Production / self-host: .env.production.example + `task selfhost:init` instead
# (docs/SELF-HOSTING.md) — this file is the local dev stack.

# ── Published host ports ──────────────────────────────────────────────────────
# Non-default on purpose: 3000/3001/3011/3012 + default 5432/6379 belong to
# other local stacks (puls & friends). drobek owns 3041 (one process: dashboard,
# OAuth AS and MCP at /mcp).
WEB_PUBLISH=3041
POSTGRES_PUBLISH=5441
REDIS_PUBLISH=6391
# mailpit web UI + REST API (SMTP stays in-network on mailpit:1025).
MAILPIT_PUBLISH=8025

# ── Container-internal listen port (PORT env the drobek service reads) ───────
WEB_PORT=3000

# ── Datastores ────────────────────────────────────────────────────────────────
# In-compose services get in-network URLs injected by docker-compose.yml
# (postgres:5432 / redis:6379). These host-side URLs are for tools running on
# the host: drizzle studio, Playwright global-setup, psql. Ports must match the
# *_PUBLISH values above.
DATABASE_URL=postgresql://drobek:drobek@localhost:5441/drobek
REDIS_URL=redis://localhost:6391

# ── App ───────────────────────────────────────────────────────────────────────
# Git short SHA baked into /api/version. `task up` exports the real one;
# "dev" is the fallback outside a git context.
GIT_SHA=dev
# Global super-admin (D: super-admin is an env flag, NOT a memberships role).
# Accepts a COMMA-SEPARATED list (U3 amendment 2026-07-02) — every entry is
# trimmed + lowercased, empty entries ignored. Single value still works.
#   SUPERADMIN_EMAIL=grasl.t@centrum.cz,freema25@gmail.com
SUPERADMIN_EMAIL=admin@example.com

# ── Public URLs (U5 OAuth AS/RS identity) ────────────────────────────────────
# These are what a browser / MCP client actually reaches the stack at. The
# compose file injects the local defaults below into the drobek service via
# ${VAR:-default}, so the dev stack works with them UNSET — set them only when
# self-hosting behind a real hostname (then it must be the externally
# reachable URL, e.g. https://drobek.example.com).
#   PUBLIC_APP_URL  — the drobek web origin: the OAuth 2.1 Authorization Server
#                     issuer advertised in /.well-known/oauth-authorization-server,
#                     the dashboard, and the base of the MCP endpoint. Apps are
#                     never served here (see APPS_DOMAIN). Falls back to
#                     PUBLIC_ORIGIN, then :3041.
#   PUBLIC_MCP_URL  — OPTIONAL full MCP endpoint URL. Defaults to
#                     PUBLIC_APP_URL + /mcp. It is the OAuth Resource Server's
#                     canonical resource identifier (== the required Bearer-token
#                     audience, RFC 8707) advertised in
#                     /.well-known/oauth-protected-resource/mcp.
PUBLIC_APP_URL=http://localhost:3041
# PUBLIC_MCP_URL=http://localhost:3041/mcp

# ── Apps origin (M0-05 / M0-06) ──────────────────────────────────────────────
# Apps live on their own hosts under APPS_DOMAIN (a DIFFERENT registrable
# domain than the dashboard in production): the published version at
# <slug>.<APPS_DOMAIN>, the working copy at <slug>--preview.<APPS_DOMAIN>,
# exactly version N at <slug>--v<N>.<APPS_DOMAIN>. The same process serves
# them (host dispatch on the Host header); the dashboard is the host of
# PUBLIC_APP_URL and never serves an app. Point a wildcard DNS record
# (*.<APPS_DOMAIN>) and a wildcard TLS certificate at the server.
# Mutating dashboard requests whose Origin is an app host are refused (403).
# Password-gated apps sign their unlock cookie with a key derived (HKDF) from
# DROBEK_MASTER_KEY — no separate secret; without the master key the gate
# fails closed.
# A bare host name with an optional :port, no scheme. REQUIRED in production
# (the server refuses to start without it); unset in dev = apps.localhost:3041
# (*.localhost resolves to loopback in browsers — no /etc/hosts needed).
# APPS_URL_SCHEME (http | https) defaults to http for localhost / *.localhost
# and https for everything else.
# APPS_DOMAIN=apps.example.com
# APPS_URL_SCHEME=https
# Unknown hosts (NSO-315): "no app here" answers per client IP per window
# before the apps origin answers 429 (unknown slugs are also cached for 30 s;
# a client without a recognised IP is never counted):
# APPS_UNKNOWN_HOST_LIMIT=60
# APPS_UNKNOWN_HOST_WINDOW_MS=60000
# Module request bodies (NSO-325): a request to /__drobek/* (module routes,
# uploads, the beacon) must deliver its whole body within this many ms, else
# 408 request_timeout. Raise it with FILES_MAX_BYTES for big uploads over slow
# links. An answer sent before a body fully arrived (413 mid-upload) always
# closes the connection instead of draining the rest. Default 120000 (2 min).
# APPS_MODULE_BODY_TIMEOUT_MS=120000

# ── Custom domains (M3-01 — docs/SELF-HOSTING.md) ──────────────────────────
# An app can be reached on its owner's own host names (shop.example.com): the
# owner adds a CNAME to <slug>.<APPS_DOMAIN> plus a TXT record
# _drobek.<host> = drobek-verify=<token> and clicks Verify on the app's
# Domains tab. A verified domain serves the published version and gets a
# certificate through Caddy's on-demand catch-all (TLS_CUSTOM_DOMAINS below).
# Verified domains are re-checked every 24 h; a definitive DNS failure drops
# the verification and e-mails the app's owners (transient errors never do).
# How many custom domains one app may have (default 3; the next add fails
# with limit_exceeded; 0 turns custom domains off). A LIMITS_PROVIDER_URL may
# set it per workspace (plans):
# DOMAINS_MAX_PER_APP=3
# Resolvers used for the verification lookups — comma-separated IPs; unset =
# the system resolver:
# DOMAINS_DNS_SERVERS=1.1.1.1,8.8.8.8
# How often the re-check sweep runs (ms, default 3600000 = 1 h); it re-checks
# only domains last checked more than 24 h ago:
# DOMAINS_RECHECK_INTERVAL_MS=3600000
# DEV/TEST ONLY — answer the lookups from Redis keys
# drobek:dns-mock:<txt|cname|a|aaaa>:<name> (JSON string arrays) and admit the
# .test TLD; ignored (with a warning) when NODE_ENV=production.
# DOMAINS_DNS_MOCK=redis

# ── TLS + client IP behind Caddy (M0-07 — docs/SELF-HOSTING.md) ────────────
# Production runs Caddy in front (docker-compose.production.yaml). The
# Caddyfile is GENERATED from these values by `task caddy:config` (it never
# contains a secret). Pick exactly ONE TLS path for *.<APPS_DOMAIN>; the
# generator refuses ambiguous combinations:
#   (a) your own wildcard certificate — paths INSIDE the caddy container
#       (TLS_CERTS_DIR is the host dir mounted read-only at /certs); after a
#       renewal run `task tls:reload`:
# TLS_WILDCARD_CERT_FILE=/certs/wildcard.crt
# TLS_WILDCARD_KEY_FILE=/certs/wildcard.key
# TLS_CERTS_DIR=./certs
#   (b) ACME DNS-01 with a Caddy DNS module (CADDY_BUILD_TARGET=dns builds
#       deployments/Dockerfile.caddy with CADDY_DNS_MODULE via xcaddy).
#       Credentials go to .env.caddy (Caddy only) and are referenced here as
#       {env.NAME} placeholders. There is NO Hostinger DNS module — delegate
#       _acme-challenge with a CNAME and set the override domain instead:
# CADDY_BUILD_TARGET=dns
# CADDY_DNS_MODULE=github.com/caddy-dns/<provider>
# TLS_DNS_PROVIDER=<provider>
# TLS_DNS_PROVIDER_ARGS={env.DNS_API_TOKEN}
# TLS_DNS_CHALLENGE_OVERRIDE_DOMAIN=_acme-challenge.<delegate-zone>
#   (c) neither: on-demand, one certificate per app host, ALWAYS gated by
#       drobek's ask endpoint (GET /api/internal/tls/ask). Needs this token
#       (≥ 32 URL-safe chars: `openssl rand -hex 32`) for BOTH drobek and
#       caddy. Unset → the ask endpoint refuses every certificate (404); a
#       set-but-weak value stops drobek from starting.
# TLS_ASK_TOKEN=
# Development only: Caddy's local CA for every site (`task dev:tls` sets it).
# TLS_INTERNAL=1
# Optional ACME account e-mail (expiry notices):
# TLS_ACME_EMAIL=ops@example.com
# Custom domains (M3-01): a catch-all on-demand site for VERIFIED custom
# domains, gated by the same ask endpoint (so it needs TLS_ASK_TOKEN). On by
# default in mode (c); set 1 to add it next to (a)/(b), 0 to turn it off.
# TLS_CUSTOM_DOMAINS=1
#
# Which client-IP header drobek trusts for per-IP rate limits:
#   unset / auto — X-Real-IP, else the RIGHTMOST X-Forwarded-For hop (an nginx
#                  front that sets X-Real-IP $remote_addr)
#   x-real-ip    — ONLY X-Real-IP, and only a literal IP (behind the bundled
#                  Caddy, which overwrites it with the TCP peer). The
#                  production compose file sets this.
# TRUST_PROXY=x-real-ip

# ── MCP OAuth (M0-04) ─────────────────────────────────────────────────────────
# Tokens are bound to the USER (every workspace they belong to) with the scopes
# read / write / publish. Clients identify themselves with a Client ID Metadata
# Document (an https client_id URL, fetched through the SSRF guard: https only,
# ≤ 64 KiB, 5 s, cached 1 h) or by Dynamic Client Registration (/oauth/register:
# 10 registrations per IP per hour; at most N clients that never got consent).
# OAUTH_DCR_MAX_UNUSED_CLIENTS=500
#
# DEV/TEST ONLY — NEVER IN PRODUCTION: exact origins (scheme://host:port) that
# may serve a CIMD document over plain http from a private address. The compose
# dev stack sets it to the e2e mock (http://proxy-echo:8099); the server ignores
# it when NODE_ENV=production.
# OAUTH_CIMD_DEV_ORIGINS=http://proxy-echo:8099

# ── Email (U2 — login codes over generic SMTP, no vendor SDKs) ────────────────
# The compose dev stack wires the web service to the mailpit sink
# (SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURE=0 — no auth needed).
# Prod uses Hostinger SMTP; the operator provides real values at deploy:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0        # 1 = implicit TLS (usually port 465)
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=no-reply@drobek.app

# ── OTP guard (U2 — layered Redis rate-limits for /login code sends) ──────────
# The docker-compose dev stack RELAXES these (100 / 500 / 50 / 5000 / 1000 via
# the ${VAR:-default} fallbacks in docker-compose.yml) so local e2e runs and
# browser verification never trip them. Production uses the strict in-code
# defaults when unset: 5 per 15 min / 20 per 24 h / 3 per 1 h / 60000 ms / 100.
# Uncomment here only to override the dev-relaxed compose defaults.
# OTP_IP_SHORT_LIMIT=100      # sends per IP per 15 min          (prod default 5)
# OTP_IP_DAILY_LIMIT=500      # sends per IP per 24 h            (prod default 20)
# OTP_EMAIL_HOURLY_LIMIT=50   # sends per e-mail per hour        (prod default 3)
# OTP_EMAIL_COOLDOWN_MS=5000  # min gap between sends per e-mail (prod default 60000)
# OTP_GLOBAL_HOURLY_MAX=1000  # global sends per hour, then auto-pause (prod default 100)
# Kill switch: set to 1 to disable email code sending entirely.
# OTP_LOGIN_DISABLED=0
# Without a resolvable client IP (see TRUST_PROXY) the per-IP send limits are
# skipped — never one shared bucket for all such clients (NSO-309); the
# per-e-mail limits and the global brake still apply.

# ── OTP verify (NSO-309 — per-IP limit on /login/verify code checks) ──────────
# Defense in depth only: the real brute-force cap is per code (5 guesses, then
# the code is destroyed; not configurable). No client IP → no per-IP bucket.
# The dev / e2e compose files relax the limit to 500.
# OTP_VERIFY_IP_LIMIT=30        # code checks per client IP per window
# OTP_VERIFY_IP_WINDOW_S=900    # window length in seconds (15 min)

# ── Google OIDC login (U3 — config-gated, PHY-53) ─────────────────────────────
# Empty/unset GOOGLE_CLIENT_ID disables the feature entirely: the "Continue
# with Google" button is hidden and /auth/google redirects to /login. Prod is
# safe when unconfigured — the app code has NO credential defaults.
#
# LOCAL DEV: docker-compose.yml injects mock-provider defaults into the web
# container (dummy creds local-dev-client/local-dev-secret + the three URLs
# below), so with the mock running (`task mock:google`, port 3049) Google
# login works out of the box. IMPORTANT URL SPLIT:
#   - GOOGLE_AUTH_URL is opened by the BROWSER on the host
#       → http://localhost:3049/authorize
#   - GOOGLE_TOKEN_URL + GOOGLE_USERINFO_URL are fetched by the web CONTAINER
#       → http://host.docker.internal:3049/token | /userinfo
#     (extra_hosts host-gateway in compose makes that resolve on linux too)
#
# REAL GOOGLE: set real GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET and leave all
# three URLs unset — the in-code defaults are the real endpoints:
#   auth     https://accounts.google.com/o/oauth2/v2/auth
#   token    https://oauth2.googleapis.com/token
#   userinfo https://www.googleapis.com/oauth2/v3/userinfo
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_AUTH_URL=
# GOOGLE_TOKEN_URL=
# GOOGLE_USERINFO_URL=
# Public origin the OAuth redirect_uri is built from
# (redirect_uri = PUBLIC_ORIGIN + /auth/google/callback; prod: https://drobek.app).
# PUBLIC_ORIGIN=http://localhost:3041

# App files (every version's sources + compiled output) live in Postgres,
# content-addressed and deduplicated — there is no blob directory to mount or
# back up separately. Unreferenced blobs are garbage-collected hourly after a
# 7-day grace period.

# ── Server start + audit (docs/SELF-HOSTING.md "Environment reference") ────
# The server applies pending migrations on every start; 0 skips that (only
# for tests and tooling — `task selfhost:migrate` applies them explicitly).
# DROBEK_MIGRATE_ON_START=1
# Audit rows older than this many days are pruned (at start, then daily) —
# the only deletion of audit rows anywhere (default 365).
# AUDIT_RETENTION_DAYS=365

# ── Apps per workspace (NSO-329) ────────────────────────────────────────────
# How many live apps one workspace may hold (default 50; deleted apps do not
# count). create_app beyond it answers limit_exceeded. A LIMITS_PROVIDER_URL
# may set it per workspace (plans).
# APPS_MAX_PER_WORKSPACE=50

# ── App compiler (M0-03 — @drobek/compile, esbuild in-process) ──────────────
# Limits for every write_files compile (defaults used when unset):
# COMPILE_MAX_FILES=200             # files per app
# COMPILE_MAX_FILE_BYTES=524288     # 512 KiB per file
# COMPILE_MAX_TOTAL_BYTES=5242880   # 5 MiB per app
# COMPILE_MAX_IMPORT_DEPTH=50
# COMPILE_TIMEOUT_MS=10000          # per build → `timeout`
# COMPILE_CONCURRENCY=4             # builds at once; the rest queue
# COMPILE_QUEUE_TIMEOUT_MS=10000    # max queue wait → `busy`

# ── data module limits (M1-03, modules/data) ──────────────────────────────────
# Enforced on EVERY record write of the `data` platform module regardless of
# the collection rules (the owner controls openness; drobek always caps
# abuse). Per app; a LIMITS_PROVIDER_URL may set them per workspace.
# Production-generous defaults (used when unset):
#   DATA_MAX_DOCS_PER_APP   = 10000     (records per app, all collections)
#   DATA_MAX_DOC_BYTES      = 102400    (100 KiB per record, JSON bytes)
#   DATA_MAX_BYTES_PER_APP  = 52428800  (50 MiB of records per app)
#   DATA_WRITE_RATE_LIMIT   = 120       (writes per window, per app)
#   DATA_WRITE_RATE_WINDOW_MS = 60000   (rate-limit window)
#   DATA_WRITES_PER_PRINCIPAL_PER_MIN = 60  (writes per minute of ONE signed-in
#                                         user, or of one visitor IP — checked
#                                         before the per-app limit, so one
#                                         client cannot use up the app's budget)
# NOTE: the local docker-compose sets a LOW DATA_MAX_DOCS_PER_APP (5) so the
# data e2e quota case can exceed it quickly — override here to raise it.
# DATA_MAX_DOCS_PER_APP=10000
# DATA_MAX_DOC_BYTES=102400
# DATA_MAX_BYTES_PER_APP=52428800
# DATA_WRITE_RATE_LIMIT=120
# DATA_WRITE_RATE_WINDOW_MS=60000
# DATA_WRITES_PER_PRINCIPAL_PER_MIN=60

# ── files module (M1-05, modules/files) ───────────────────────────────────────
# End-user uploads are stored on disk, content-addressed, under FILES_DIR
# (the production compose mounts the `files_data` volume there — back it up
# with the database). The limits hold regardless of the app's rules; an app's
# config can only LOWER the per-file cap. Per app; a LIMITS_PROVIDER_URL may
# set them per workspace. Defaults (used when unset):
#   FILES_DIR               = /data/files
#   FILES_MAX_BYTES         = 10485760   (10 MiB per file; a bigger upload is
#                                         cut off while streaming → 413)
#   FILES_QUOTA_PER_APP     = 524288000  (500 MiB of files per app → 409 quota_exceeded)
#   FILES_UPLOAD_RATE_LIMIT = 60         (uploads per minute, per app)
#   FILES_UPLOADS_PER_PRINCIPAL_PER_MIN = 20 (uploads per minute of ONE
#                                         signed-in user, or of one visitor
#                                         IP — checked before the per-app limit)
#   FILES_SWEEP_INTERVAL_MS  = 3600000   (1 h: how often the sweep runs)
#   FILES_SWEEP_RETENTION_MS = 86400000  (24 h: the sweep removes the uploads
#                                         of apps deleted this long ago, temp
#                                         uploads untouched this long, and
#                                         blobs this old that no app references)
# NOTE: the local docker-compose (and the e2e image compose) set a LOW
# FILES_QUOTA_PER_APP (2 MiB) so the files e2e quota case exceeds it quickly.
# FILES_DIR=/data/files
# FILES_MAX_BYTES=10485760
# FILES_QUOTA_PER_APP=524288000
# FILES_UPLOAD_RATE_LIMIT=60
# FILES_UPLOADS_PER_PRINCIPAL_PER_MIN=20
# FILES_SWEEP_INTERVAL_MS=3600000
# FILES_SWEEP_RETENTION_MS=86400000

# ── Error beacon + serving signals (PHY-123 — agent loop v1) ──────────────────
# The error beacon is PUBLIC + UNAUTHENTICATED (it moves to the apps origin as
# /__drobek/v1/_beacon; no route serves it on the dashboard host). It is
# bounded on every axis: an 8 KB payload cap (fixed), a per-app+IP rate-limit,
# an optional sample rate, and a per-app ring buffer (newest N / max age).
# Production defaults (used when unset):
#   BEACON_RATE_LIMIT         = 60      (beacons per window, per app+IP)
#   BEACON_APP_RATE_LIMIT     = 600     (per window, per app — IP-INDEPENDENT;
#                                        bounds ingest when X-Forwarded-For is
#                                        rotated to dodge the per-IP bucket)
#   BEACON_RATE_WINDOW_MS     = 60000   (rate-limit window)
#   BEACON_MAX_EVENTS_PER_APP = 500     (ring buffer: newest N events kept)
#   BEACON_RETENTION_DAYS     = 30      (ring buffer: max event age = the get_logs window)
#   BEACON_SAMPLE_RATE        = 1       (1 = keep all; <1 = randomly sample)
# NOTE: the local docker-compose sets a LOW BEACON_RATE_LIMIT (30) so the
# beacon-flood e2e trips 429 quickly — override here to raise it.
# BEACON_RATE_LIMIT=60
# BEACON_APP_RATE_LIMIT=600
# BEACON_RATE_WINDOW_MS=60000
# BEACON_MAX_EVENTS_PER_APP=500
# BEACON_RETENTION_DAYS=30
# BEACON_SAMPLE_RATE=1
# The get_logs retention prune (in the server process, one replica at a time
# via a Redis lease): browser errors, compiles and daily request stats older
# than 30 days (errors past the newest BEACON_MAX_EVENTS_PER_APP per app) are
# removed for every app this often. Reads never delete.
# LOGS_PRUNE_INTERVAL_MS=3600000

# ── BFF proxy v1 (PHY-59) ─────────────────────────────────────────────────────
# The proxy lets a static app reach a backend WITHOUT holding its secret: drobek
# is the SSRF-guarded, secret-injecting gateway. Every upstream secret is stored
# AES-256-GCM envelope-encrypted (a random per-secret DEK wrapped by this KEK).
#
# REQUIRED for the proxy secret store — a secret operation fails CLOSED without
# it. Generate a real 32-byte key:  openssl rand -hex 32
# (the local docker-compose injects an all-zero DEV key; prod .env.production
# MUST set a real one — rotating it re-keys via the stored kek_id.) With
# NODE_ENV=production a missing, all-zero or `change-me…` KEK aborts startup.
DROBEK_MASTER_KEY=change-me-generate-with-openssl-rand-hex-32
# Operator allow-list of upstream hostnames whose resolved PRIVATE IP the SSRF
# guard may still connect to (comma/space separated). EMPTY by default → fully
# strict (every private/reserved IP blocked). Only set this to reach a specific
# internal backend you trust. The local compose sets it to the e2e echo target.
# PROXY_ALLOWED_HOSTS=
# Destination ports an upstream base_url may use (PHY-76 #8): checked when the
# upstream is registered AND again when drobek connects. Default 80,443.
# PROXY_ALLOWED_PORTS=80,443
# Per-request upstream connect/idle timeout + response size cap (defaults 8000ms
# / 5 MiB); a whole proxied call is also capped at 20 s.
# PROXY_CONNECT_TIMEOUT_MS=8000
# PROXY_MAX_RESPONSE_BYTES=5242880
# Upstream calls in flight at once (each may buffer PROXY_MAX_RESPONSE_BYTES for
# up to 20 s): for the whole server, and per app. Over either → 429 proxy_busy.
# PROXY_MAX_CONCURRENT=32
# PROXY_MAX_CONCURRENT_PER_APP=8
# The `proxy` module's limits (per workspace via LIMITS_PROVIDER_URL): calls
# per app per minute (all upstreams), and per client IP per minute to an
# upstream whose call rule is `public`.
# PROXY_CALLS_PER_MIN=60
# PROXY_PUBLIC_CALLS_PER_MIN_PER_IP=10

# ── Platform modules (M1-01, docs/MODULES.md) ─────────────────────────────────
# Comma-separated modules this server runs. A short name `x` loads the npm
# package `drobek-module-x`; a full package name (`@scope/pkg`,
# `drobek-module-x`) is used as written. Third-party modules are resolved from
# the SERVER's dependencies (DROBEK_MODULES_ROOT, default the working
# directory: /app in the image, apps/server in the dev stack). Empty = no
# modules (agents build self-contained front-ends). A module that cannot be
# loaded stops the start. The dev compose enables the example `hello` and
# the built-in `auth` (end-user sign-in; modules/auth, package
# `drobek-module-auth`, shipped in the image), `email` (app notifications to
# the app's owners, the per-app mail limit), `forms` (form submissions;
# requires `email` — a missing dependency stops the start with a message) and
# `data` (per-app collections of records with per-operation rules; its first
# migration imports and drops the pre-module Data API tables); `proxy` (apps
# call the workspace's upstreams with the secret injected server-side) and
# `files` (end-user uploads on FILES_DIR, see above):
# DROBEK_MODULES=auth,email,forms,data,proxy,files.
# DROBEK_MODULES=
# DROBEK_MODULES_ROOT=
# General skills for skill_info: <dir>/<name>/SKILL.md (default ./skills or
# ../../skills; the image ships the repo's skills/ at /app/skills).
# DROBEK_SKILLS_DIR=
# Per-workspace limits (plans) for modules, APPS_MAX_PER_WORKSPACE and
# DOMAINS_MAX_PER_APP: GET <url>/limits/<workspace_id>,
# signed X-Drobek-Signature: v1=<hex HMAC-SHA256(secret, "<ts>.GET.<path>")>,
# answer {"limits":{"<ENV_NAME>":<int>}}; cached 60 s in Redis; when the
# provider is down, each limit falls back to its env var / module default and
# a warning is logged. The secret must be ≥ 32 random chars (openssl rand -hex 32).
# LIMITS_PROVIDER_URL=
# LIMITS_PROVIDER_SECRET=
# The example module's limit (drobek-module-hello): waves per visitor per minute.
# HELLO_WAVES_PER_MINUTE=30
# The auth module's limits (per app; defaults shown). Sign-in codes per client
# IP per 15 min / per day, per address per hour, per app per hour (then the
# app's sign-in e-mails pause 15 min); send-code + verify calls per IP per
# 15 min; end users per app.
# AUTH_CODES_PER_IP_15MIN=5
# AUTH_CODES_PER_IP_DAY=20
# AUTH_CODES_PER_EMAIL_HOUR=3
# AUTH_CODES_PER_APP_HOUR=100
# AUTH_ATTEMPTS_PER_IP_15MIN=30
# END_USERS_MAX_PER_APP=1000
# The email module's limits (per app, defaults shown): notification e-mails
# per app per day (sign-in codes excluded — AUTH_CODES_PER_APP_HOUR caps
# those); drobek.email.notifyAdmins() calls per signed-in user per day.
# EMAIL_PER_APP_PER_DAY=50
# EMAIL_NOTIFY_ADMINS_PER_DAY=20
# Operator-wide cap on ALL module e-mail (sign-in codes + notifications),
# counted in recipients per hour across every app, split in two budgets:
# sign-in codes get EMAIL_SIGNIN_HOURLY_MAX (default 20 % of the cap, at
# least 50, at most half), notifications the rest — and one app at most
# EMAIL_APP_HOURLY_SHARE percent of the notifications (default 25). Past its
# budget a class pauses for exactly EMAIL_GLOBAL_PAUSE_MINUTES and then starts
# a fresh hourly budget (the other class keeps going) and an
# `email_global_pause` ALERT line (audience super_admin, with
# `class`) is logged; resume early by deleting the Redis key
# `drobek:mail:paused:notification` / `drobek:mail:paused:sign_in`. Not
# overridable by the limits provider.
# EMAIL_GLOBAL_HOURLY_MAX=500
# EMAIL_GLOBAL_PAUSE_MINUTES=15
# EMAIL_SIGNIN_HOURLY_MAX=100
# EMAIL_APP_HOURLY_SHARE=25
# One app may send at most this percent of the sign-in budget per hour
# (default 25, at least 10 codes) — so one app can never pause sign-in for
# every app; the auth module's AUTH_CODES_PER_APP_HOUR is clamped to it.
# EMAIL_SIGNIN_APP_HOURLY_SHARE=25
# One workspace (all its apps together) may send at most this percent of the
# notification budget and of the sign-in budget per hour (default 50, never
# less than one app's share) — raise it to 100 on a single-workspace server.
# EMAIL_WORKSPACE_HOURLY_SHARE=50
# The forms module's limits: submissions per client IP per hour (per app),
# submissions per app per day. The forms time token (`_t`, an HMAC proving the
# page was open ≥ 2 s) and the stored IP hashes are keyed from
# DROBEK_MASTER_KEY (HKDF, label drobek/forms-token/v1) — no separate secret;
# without the master key form submissions answer 503 `unavailable`.
# FORMS_SUBMITS_PER_IP_HOUR=10
# FORMS_PER_APP_PER_DAY=200

# LANDING_URL — your own website: <PUBLIC_APP_URL>/ answers 301 there instead
# of the built-in landing page (the dashboard host stays noindex).
# LANDING_URL=https://www.example.com/

# DASHBOARD_GITHUB_STARS — the dashboard footer shows the GitHub star count of
# the source repository, fetched server-side from api.github.com
# (unauthenticated, 3 s timeout, cached in memory for 1 h; a failure just omits
# the stars and never delays a page). `off` = no outbound call.
# DASHBOARD_GITHUB_STARS=off

# ── Abuse handling (M4-02 — docs/SELF-HOSTING.md "Abuse and takedowns") ──────
# Every app host answers GET /.well-known/drobek-report with the report form
# (<PUBLIC_APP_URL>/report?host=…, no login); reports land in the super-admin
# queue at /admin/abuse and are e-mailed to SUPERADMIN_EMAIL (one mail per app
# per hour). A takedown answers 451 on every host of the app with a link to
# TERMS_URL (default <PUBLIC_APP_URL>/terms — set it if your dashboard origin
# serves no terms page).
# TERMS_URL=https://example.com/terms
# Valid reports per client IP per hour on the public form.
# ABUSE_REPORTS_PER_IP_HOUR=5
# The publish heuristic flags (never blocks) an app whose published version has
# a password field AND one of these words in its <title>, an <h1>, the page text
# or a JS string (comma-separated, case/diacritics-insensitive, whole words).
# Unset/empty = the built-in list (paypal, apple id, google, microsoft, …, bank).
# ABUSE_BRAND_WORDS=paypal,revolut,my bank name

# ── e2e (tests-e2e/) ──────────────────────────────────────────────────────────
# BASE_URL_WEB=http://localhost:3041
# BASE_URL_MCP=http://localhost:3041   # defaults to BASE_URL_WEB
# TEST_ENV=local
# Destructive seeding (TRUNCATE in global-setup) additionally requires
# ALLOW_DESTRUCTIVE=1 AND a DATABASE_URL host in [localhost, 127.0.0.1, postgres].
# ALLOW_DESTRUCTIVE=1
