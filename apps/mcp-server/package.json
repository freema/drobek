{
  "name": "mcp-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@drobek/core": "workspace:*",
    "@drobek/data": "workspace:*",
    "@drobek/db": "workspace:*",
    "@drobek/deploy": "workspace:*",
    "@drobek/oauth": "workspace:*",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.41.0",
    "express": "^4.21.2",
    "ioredis": "^5.6.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
