{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["./server/**/*.ts"],
  "exclude": ["./server/**/*.test.ts"]
}
