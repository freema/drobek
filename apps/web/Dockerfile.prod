# syntax=docker/dockerfile:1.4
# ============================================
# drobek — Web (apps/web) Production Dockerfile
# React Router v7 SSR
# Workspace: @drobek/db, @drobek/core, @drobek/auth (web only), @drobek/sdk
# Container port 3000 (published as 3041 locally and on the VPS)
# GHCR (P0-D): drobek-selfhost-web (public) / drobek-saas-web (private)
# NOTE: runner MUST stay the LAST stage (default build target), and the
# runner WORKDIR MUST be the app dir — RR7 assetsBuildDirectory is relative.
# ============================================

# --- Base ---
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
WORKDIR /app

# --- Deps (full install incl. dev — needed for the build) ---
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/mcp-server/package.json ./apps/mcp-server/
COPY packages/db/package.json ./packages/db/
COPY packages/core/package.json ./packages/core/
COPY packages/auth/package.json ./packages/auth/
COPY packages/tenancy/package.json ./packages/tenancy/
COPY packages/insights/package.json ./packages/insights/
COPY packages/serving/package.json ./packages/serving/
COPY packages/deploy/package.json ./packages/deploy/
COPY packages/audit/package.json ./packages/audit/
COPY packages/data/package.json ./packages/data/
COPY packages/proxy/package.json ./packages/proxy/
COPY packages/agent-dx/package.json ./packages/agent-dx/
COPY packages/dashboard/package.json ./packages/dashboard/
COPY packages/oauth/package.json ./packages/oauth/
COPY packages/sdk/package.json ./packages/sdk/
COPY tests-e2e/package.json ./tests-e2e/
RUN pnpm install --frozen-lockfile

# --- Builder (compile workspace packages, build the web app) ---
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=deps /app/packages/core/node_modules ./packages/core/node_modules
COPY --from=deps /app/packages/auth/node_modules ./packages/auth/node_modules
COPY --from=deps /app/packages/tenancy/node_modules ./packages/tenancy/node_modules
COPY --from=deps /app/packages/insights/node_modules ./packages/insights/node_modules
COPY --from=deps /app/packages/serving/node_modules ./packages/serving/node_modules
COPY --from=deps /app/packages/deploy/node_modules ./packages/deploy/node_modules
COPY --from=deps /app/packages/audit/node_modules ./packages/audit/node_modules
COPY --from=deps /app/packages/data/node_modules ./packages/data/node_modules
COPY --from=deps /app/packages/proxy/node_modules ./packages/proxy/node_modules
COPY --from=deps /app/packages/agent-dx/node_modules ./packages/agent-dx/node_modules
COPY --from=deps /app/packages/dashboard/node_modules ./packages/dashboard/node_modules
COPY --from=deps /app/packages/oauth/node_modules ./packages/oauth/node_modules
COPY --from=deps /app/packages/sdk/node_modules ./packages/sdk/node_modules

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/web ./apps/web

RUN pnpm --filter @drobek/db build \
 && pnpm --filter @drobek/core build \
 && pnpm --filter @drobek/audit build \
 && pnpm --filter @drobek/auth build \
 && pnpm --filter @drobek/tenancy build \
 && pnpm --filter @drobek/insights build \
 && pnpm --filter @drobek/serving build \
 && pnpm --filter @drobek/deploy build \
 && pnpm --filter @drobek/data build \
 && pnpm --filter @drobek/proxy build \
 && pnpm --filter @drobek/agent-dx build \
 && pnpm --filter @drobek/dashboard build \
 && pnpm --filter @drobek/oauth build \
 && pnpm --filter @drobek/sdk build
RUN pnpm --filter web build

# --- Prod deps (production-only, no dev deps) ---
FROM base AS prod-deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/mcp-server/package.json ./apps/mcp-server/
COPY packages/db/package.json ./packages/db/
COPY packages/core/package.json ./packages/core/
COPY packages/auth/package.json ./packages/auth/
COPY packages/tenancy/package.json ./packages/tenancy/
COPY packages/insights/package.json ./packages/insights/
COPY packages/serving/package.json ./packages/serving/
COPY packages/deploy/package.json ./packages/deploy/
COPY packages/audit/package.json ./packages/audit/
COPY packages/data/package.json ./packages/data/
COPY packages/proxy/package.json ./packages/proxy/
COPY packages/agent-dx/package.json ./packages/agent-dx/
COPY packages/dashboard/package.json ./packages/dashboard/
COPY packages/oauth/package.json ./packages/oauth/
COPY packages/sdk/package.json ./packages/sdk/
COPY tests-e2e/package.json ./tests-e2e/
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

# --- Runner (final production image — MUST be the last stage) ---
FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

ARG GIT_SHA=dev
ENV GIT_SHA=$GIT_SHA

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 appuser

WORKDIR /app

# Production node_modules (workspace symlinks resolve via package.jsons below)
COPY --from=prod-deps --chown=appuser:nodejs /app/node_modules ./node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/packages/core/node_modules ./packages/core/node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/packages/auth/node_modules ./packages/auth/node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/packages/tenancy/node_modules ./packages/tenancy/node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/packages/insights/node_modules ./packages/insights/node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/packages/serving/node_modules ./packages/serving/node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/packages/deploy/node_modules ./packages/deploy/node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/packages/audit/node_modules ./packages/audit/node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/packages/data/node_modules ./packages/data/node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/packages/proxy/node_modules ./packages/proxy/node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/packages/dashboard/node_modules ./packages/dashboard/node_modules
COPY --from=prod-deps --chown=appuser:nodejs /app/packages/oauth/node_modules ./packages/oauth/node_modules
# NOTE: no packages/sdk/node_modules nor packages/agent-dx/node_modules —
# @drobek/sdk and @drobek/agent-dx have zero prod deps, so the prod install
# creates none.

# Workspace metadata (pnpm symlink resolution at runtime)
COPY --from=builder --chown=appuser:nodejs /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml ./

# Workspace package compiled output
COPY --from=builder --chown=appuser:nodejs /app/packages/db/package.json ./packages/db/
COPY --from=builder --chown=appuser:nodejs /app/packages/db/dist ./packages/db/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/core/package.json ./packages/core/
COPY --from=builder --chown=appuser:nodejs /app/packages/core/dist ./packages/core/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/auth/package.json ./packages/auth/
COPY --from=builder --chown=appuser:nodejs /app/packages/auth/dist ./packages/auth/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/tenancy/package.json ./packages/tenancy/
COPY --from=builder --chown=appuser:nodejs /app/packages/tenancy/dist ./packages/tenancy/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/insights/package.json ./packages/insights/
COPY --from=builder --chown=appuser:nodejs /app/packages/insights/dist ./packages/insights/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/serving/package.json ./packages/serving/
COPY --from=builder --chown=appuser:nodejs /app/packages/serving/dist ./packages/serving/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/deploy/package.json ./packages/deploy/
COPY --from=builder --chown=appuser:nodejs /app/packages/deploy/dist ./packages/deploy/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/audit/package.json ./packages/audit/
COPY --from=builder --chown=appuser:nodejs /app/packages/audit/dist ./packages/audit/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/data/package.json ./packages/data/
COPY --from=builder --chown=appuser:nodejs /app/packages/data/dist ./packages/data/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/proxy/package.json ./packages/proxy/
COPY --from=builder --chown=appuser:nodejs /app/packages/proxy/dist ./packages/proxy/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/agent-dx/package.json ./packages/agent-dx/
COPY --from=builder --chown=appuser:nodejs /app/packages/agent-dx/dist ./packages/agent-dx/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/dashboard/package.json ./packages/dashboard/
COPY --from=builder --chown=appuser:nodejs /app/packages/dashboard/dist ./packages/dashboard/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/oauth/package.json ./packages/oauth/
COPY --from=builder --chown=appuser:nodejs /app/packages/oauth/dist ./packages/oauth/dist
COPY --from=builder --chown=appuser:nodejs /app/packages/sdk/package.json ./packages/sdk/
COPY --from=builder --chown=appuser:nodejs /app/packages/sdk/dist ./packages/sdk/dist

# Web app build artifacts
COPY --from=builder --chown=appuser:nodejs /app/apps/web/package.json ./apps/web/
COPY --from=builder --chown=appuser:nodejs /app/apps/web/build ./apps/web/build
# Worker entry (drobek-worker runs this file from the same image).
COPY --from=builder --chown=appuser:nodejs /app/apps/web/scripts ./apps/web/scripts

# RR7 gotcha: assetsBuildDirectory ("build/client") is relative — a wrong CWD
# means 404 on every /assets/* request.
WORKDIR /app/apps/web

USER appuser
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget -q -T 5 -O - http://127.0.0.1:3000/healthz || exit 1

CMD ["pnpm", "start"]
