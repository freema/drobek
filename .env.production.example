# drobek — production / self-host environment (docker-compose.production.yaml).
#
#   task selfhost:init        copies this file to .env.production (mode 600),
#                             generates every secret, fills in the domain + TLS
#                             mode, renders deployments/Caddyfile
#
# Then edit .env.production for what only you know (SMTP, your e-mail) and
# start the stack — docs/SELF-HOSTING.md has the whole procedure. NEVER commit
# .env.production (it is gitignored) and keep a copy of it next to your backups:
# DROBEK_MASTER_KEY is needed to read a restored database's encrypted secrets.
#
# Format rules (the file is read by docker compose AND `docker run --env-file`):
# one KEY=value per line, no spaces around `=`, no inline comments. Wrap a
# value that contains `$`, `#` or spaces in single quotes (SMTP_PASS='p#ss$').
#
# [secret] = generated by `task selfhost:init` (openssl rand -hex 32) — leave
# empty here; init only fills EMPTY values and never overwrites an existing one.
# [required] = docker compose refuses to start without it (${VAR:?}).

# ── Image ─────────────────────────────────────────────────────────────────────
# ghcr.io/freema/drobek:<tag>. `latest` = the newest release, `vX.Y.Z` = one
# release (pin it for reproducible upgrades), `previous` = the release before
# `latest` (rollback). linux/amd64 only.
DROBEK_IMAGE_TAG=latest

# ── Hosts [required] ──────────────────────────────────────────────────────────
# The dashboard, OAuth server and MCP endpoint (<PUBLIC_APP_URL>/mcp). https,
# bare origin. DNS: an A/AAAA record for this host → the server.
PUBLIC_APP_URL=https://drobek.example.com
# Invite links + the Google redirect_uri. Defaults to PUBLIC_APP_URL.
# PUBLIC_ORIGIN=https://drobek.example.com
# Apps live on <slug>.<APPS_DOMAIN>, <slug>--preview.<APPS_DOMAIN>,
# <slug>--v<N>.<APPS_DOMAIN>. A bare host name (plus :port when HTTPS_PORT is
# not 443). DNS: a WILDCARD record *.<APPS_DOMAIN> → the server. A separate
# registrable domain from the dashboard is the safer choice.
APPS_DOMAIN=apps.example.com

# ── Published ports (optional) ────────────────────────────────────────────────
# Caddy is the only service with ports. HTTPS_PORT is the host AND in-container
# port; with anything but 443 every URL carries it (task selfhost:init adds it).
# Let's Encrypt needs 80 + 443 reachable from the internet.
# HTTP_PORT=80
# HTTPS_PORT=443
# Bind one address only (e.g. 127.0.0.1 behind another proxy). Unset = all.
# PUBLISH_IP=

# ── Secrets [secret] ──────────────────────────────────────────────────────────
# The postgres password (only used when the pg_data volume is FIRST created —
# changing it later does not change the database's password).
POSTGRES_PASSWORD=
# The key everything encrypted at rest is derived from: upstream and module
# secrets (AES-256-GCM envelope), password-gated app cookies, forms tokens. 64
# hex chars. drobek refuses to start without it, with an all-zero or a
# change-me value, or when a stored secret is under a key it does not have.
# Losing it = losing every stored secret.
DROBEK_MASTER_KEY=
# Only while rotating DROBEK_MASTER_KEY: the old key. Secrets stored under it
# still decrypt until `task selfhost:rekey` re-wraps them under the new
# DROBEK_MASTER_KEY; then remove this line (docs/SELF-HOSTING.md, "Rotating
# DROBEK_MASTER_KEY"). Never generated by `task selfhost:init`.
# DROBEK_MASTER_KEY_PREVIOUS=
# Shared by drobek and Caddy for on-demand TLS: Caddy asks
# http://drobek:3000/api/internal/tls/ask?token=… before every new
# certificate. ≥ 32 URL-safe chars. Generated for every TLS mode (harmless when
# unused; switching to on-demand later needs no new secret).
TLS_ASK_TOKEN=

# ── TLS for *.<APPS_DOMAIN> — exactly ONE path ───────────────────────────────
# The dashboard host always gets a normal ACME certificate (HTTP-01/TLS-ALPN),
# except with TLS_INTERNAL=1. `task selfhost:init TLS_MODE=<mode>` sets these;
# after changing them by hand re-run `task selfhost:init` (re-renders the
# Caddyfile) and `task tls:reload`. The generator refuses ambiguous settings.
#
# (internal) Caddy's local CA for every site — a test box / no public DNS.
# Browsers warn until you trust the root (docker compose … cp
# caddy:/data/caddy/pki/authorities/local/root.crt .).
# TLS_INTERNAL=1
#
# (on-demand) none of the TLS_* mode variables set: Let's Encrypt issues one
# certificate per app host at its first handshake, ONLY for hosts of existing
# apps (drobek's ask endpoint, TLS_ASK_TOKEN above). The default for a real
# domain; fine for a handful of apps (LE rate limits per registered domain).
#
# (wildcard-file) your own *.<APPS_DOMAIN> certificate, renewed by you; paths
# INSIDE the caddy container, TLS_CERTS_DIR is the host dir mounted at /certs.
# After every renewal: task tls:reload.
# TLS_WILDCARD_CERT_FILE=/certs/wildcard.crt
# TLS_WILDCARD_KEY_FILE=/certs/wildcard.key
# TLS_CERTS_DIR=./certs
#
# (dns) a wildcard via ACME DNS-01 with a Caddy DNS module, built from
# deployments/Dockerfile.caddy (docker compose … build caddy). Credentials go
# to .env.caddy (Caddy only) and are referenced as {env.NAME} placeholders.
# No module for your DNS host → delegate _acme-challenge with a CNAME and set
# the override domain (docs/SELF-HOSTING.md).
# CADDY_IMAGE=drobek-caddy:dns
# CADDY_BUILD_TARGET=dns
# CADDY_DNS_MODULE=github.com/caddy-dns/<provider>
# TLS_DNS_PROVIDER=<provider>
# TLS_DNS_PROVIDER_ARGS={env.DNS_API_TOKEN}
# TLS_DNS_CHALLENGE_OVERRIDE_DOMAIN=_acme-challenge.<delegate-zone>
#
# ACME account e-mail for expiry notices (not with TLS_INTERNAL=1).
# TLS_ACME_EMAIL=ops@example.com

# ── E-mail (sign-in codes, invites, module notifications) ────────────────────
# One transport carries all of it: EMAIL_TRANSPORT=smtp (default), resend, or
# the id of a transport an installed module contributes (the email.transport
# slot; set the secret env vars the module names, e.g. POSTMARK_TOKEN).
# drobek refuses to start without a usable one.
# EMAIL_TRANSPORT=smtp
#
# A module transport's send is cut off after this many milliseconds.
# EMAIL_TRANSPORT_TIMEOUT_MS=10000
#
# smtp: any SMTP server. SMTP_HOST is [required]; SMTP_SECURE=1 = implicit TLS
# (usually port 465), 0 = STARTTLS/plain (587). SMTP_USER + SMTP_PASS both set
# = authenticated. SMTP_PASS is a secret you get from your mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
#
# How long a send waits on the SMTP server (milliseconds, 1000–120000): to
# connect, for its greeting, and on a silent socket.
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=30000
#
# resend: the Resend HTTP API (no SMTP_* needed). RESEND_API_KEY is [required]
# and a secret (Resend dashboard → API Keys, "sending access" is enough);
# EMAIL_FROM must be on a domain verified in Resend.
# RESEND_API_KEY=
#
# The sender address (a bare address is sent as 'drobek <address>'; set
# 'Name <address>' in single quotes for another display name).
EMAIL_FROM=no-reply@example.com

# ── Operator ──────────────────────────────────────────────────────────────────
# Your sign-in e-mail(s), comma-separated: super-admin over every workspace.
SUPERADMIN_EMAIL=

# ── Backups and container logs (docs/SELF-HOSTING.md "Backup and restore") ───
# `task backup` writes BACKUP_DIR/drobek-<UTC>.tar.gz. It refuses to start
# unless that disk has twice the data (database tables + volumes) plus
# BACKUP_MIN_FREE_MB free, verifies the new archive, then keeps the newest
# BACKUP_KEEP archives and deletes older ones (0 = keep all). A failed backup
# deletes nothing. `BACKUP_KEEP=30 task backup` overrides a value for one run.
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# BACKUP_MIN_FREE_MB=1024
# Every container's log (docker compose logs) rotates: at most
# CONTAINER_LOG_MAX_FILES files of CONTAINER_LOG_MAX_SIZE each (100 MB per
# service by default).
# CONTAINER_LOG_MAX_SIZE=20m
# CONTAINER_LOG_MAX_FILES=5

# ── Error reporting (optional) ────────────────────────────────────────────────
# Server errors always go to the container log. To also send them elsewhere
# (an incident webhook, a log service, …): install a module that contributes an error reporter (the
# errors.reporter slot, docs/MODULES.md), add it to DROBEK_MODULES, set its
# id here and the secret env vars the module names (e.g. WEBHOOK_TOKEN).
# ERROR_REPORTER=
# A delivery is cut off after this many milliseconds; at most this many
# reports go out per minute (the rest are only logged).
# ERROR_REPORTER_TIMEOUT_MS=5000
# ERROR_REPORTER_MAX_PER_MINUTE=60

# ── Custom domains (docs/SELF-HOSTING.md "Custom domains") ───────────────────
# Owners add their own host names on an app's Domains tab (CNAME to
# <slug>.<APPS_DOMAIN> + TXT _drobek.<host>). VERIFIED ones get a certificate
# from Caddy's on-demand catch-all behind the ask endpoint (TLS_ASK_TOKEN): on
# by default in on-demand mode; 1 adds it to wildcard-file / dns, 0 turns it
# off (then re-run task selfhost:init + task tls:reload).
# TLS_CUSTOM_DOMAINS=1
# Custom domains per app (0 = off); LIMITS_PROVIDER_URL may set it per workspace.
# DOMAINS_MAX_PER_APP=3
# DOMAINS_DNS_SERVERS=1.1.1.1,8.8.8.8

# Your own website for the dashboard's `/`: an anonymous visitor of
# <PUBLIC_APP_URL>/ gets a 301 there instead of the built-in landing page.
# LANDING_URL=https://www.example.com/

# A website with the drobek docs (<DOCS_URL>/agent, /modules, … and their
# .md twins): llms.txt, llms-full.txt and the build page link it instead of
# the Markdown files on GitHub.
# DOCS_URL=https://docs.example.com/docs

# The dashboard footer shows the GitHub star count of the source repository
# (fetched from api.github.com, cached 1 h, never delays a page). `off` = no
# outbound call (e.g. an egress-restricted server).
# DASHBOARD_GITHUB_STARS=off

# After an update to a new release line (0.8 → 0.9) every signed-in person
# sees a dismissible "drobek was updated · What's new" notice linking to
# /whats-new (the release notes of the running version). 0 = no notice.
# WHATS_NEW_BANNER=0

# ── Abuse handling (docs/SELF-HOSTING.md "Abuse and takedowns") ───────────────
# Reports reach SUPERADMIN_EMAIL and the /admin/abuse queue. A taken-down app
# answers 451 with a link to TERMS_URL (default <PUBLIC_APP_URL>/terms — set it
# when your dashboard origin serves no terms page).
# TERMS_URL=https://example.com/terms
# ABUSE_REPORTS_PER_IP_HOUR=5
# ABUSE_BRAND_WORDS=paypal,revolut,my bank name
# Days a resolved report is kept after it was resolved (open reports stay).
# ABUSE_REPORTS_RETENTION_DAYS=365

# ── Public gallery (docs/SELF-HOSTING.md "Public gallery") ────────────────────
# Off by default. `true` = owners may list published apps; your website reads
# GET <PUBLIC_APP_URL>/api/public/gallery.
# GALLERY_ENABLED=true
# GALLERY_API_PER_IP_MINUTE=60
# GALLERY_OPENS_PER_IP_HOUR=60
# GALLERY_LIKES_PER_USER_HOUR=30
# Your gallery website's origin(s), space-separated: they may frame a listed
# app's production host as a live preview. Unset = no embedding.
# GALLERY_FRAME_ANCESTORS=https://www.example.com
# Copies of gallery apps (owner opted in with "Allow duplicates") one person may
# make per hour, dashboard /duplicate/<slug> and MCP duplicate_app together.
# DUPLICATES_PER_USER_HOUR=10

# ── Publishing (docs/SELF-HOSTING.md "Publish approval") ──────────────────────
# `open` (default) = every workspace may publish unless a super-admin blocked it
# at /admin/publishing. `approval` = sign-up and previews stay open, but a
# workspace publishes only after a super-admin allowed it. Needs SUPERADMIN_EMAIL.
# PUBLISH_APPROVAL=approval
# Shown to refused users; gets approval requests, publish notifications and
# abuse reports (default: SUPERADMIN_EMAIL).
# OPERATOR_EMAIL=ops@example.com
# E-mail the operator about publishes: off (default) | first | every (one per app per hour).
# PUBLISH_NOTIFY=first

# ── Platform modules ──────────────────────────────────────────────────────────
# Default (unset): all eight built-ins. `forms` requires `email`; `sync` requires
# `proxy` and `data`; `oidc` requires `auth`.
# DROBEK_MODULES=auth,email,forms,data,proxy,files,sync,oidc,webhooks
# Server-wide config defaults of one module (a JSON merge patch over its
# defaults, validated at start): DROBEK_MODULE_<NAME>_DEFAULTS, e.g.
# DROBEK_MODULE_AUTH_DEFAULTS={"allow":{"domains":["acme.com"]}}
# Modules you installed (one directory per module + modules.lock.json; the
# compose file mounts the modules_data volume there, part of `task backup`).
# Install with `task selfhost:module:add -- <npm spec>` (docs/SELF-HOSTING.md
# "Third-party modules"). Looked up before the image's own modules; a module
# the lockfile does not list, or whose files changed, refuses the start.
# Change it only for a derived image that bakes its modules into another
# directory ("Derived image") — `task selfhost:module:*` manage /data/modules.
# DROBEK_MODULES_DIR=/data/modules
# Development only — ignored in production: skip the modules.lock.json check.
# DROBEK_MODULES_UNLOCKED=
# An opt-in module runs only where a super-admin enables it (Workspace →
# Modules) or the limits provider answers MODULE_ENABLED_<NAME>: 1; the env
# value 1 enables it on every workspace, e.g.:
# MODULE_ENABLED_CRM=1

# ── Optional: one company IdP for every app (the oidc module) ──────────────────
# An app that turns on providers.oidc without its own issuer signs in here
# (the issuer's host may be on your private network). Redirect URI to register
# at the IdP: <PUBLIC_APP_URL>/__drobek/auth/callback/oidc. Apps may still set
# their own issuer, client and OIDC_CLIENT_SECRET in the dashboard.
# AUTH_OIDC_ISSUER=https://sso.example.com/realms/staff
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# Seconds an IdP's discovery document is cached:
# OIDC_DISCOVERY_CACHE_SEC=3600

# ── Optional: Google sign-in ──────────────────────────────────────────────────
# Unset = the "Continue with Google" button is hidden. Redirect URI to register
# at Google: <PUBLIC_ORIGIN>/auth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Limits ────────────────────────────────────────────────────────────────────
# Every limit has a production default. The full list with defaults (OTP_*,
# COMPILE_*, READINESS_*, DATA_*, FILES_*, BEACON_*, LOGS_*, PROXY_*, SYNC_*, WEBHOOKS_*, AUTH_*, EMAIL_*, FORMS_*,
# DOMAINS_*, ABUSE_*, LIMITS_PROVIDER_URL) is documented in .env.example and docs/SELF-HOSTING.md;
# add any of them here to override, e.g.:
# APPS_MAX_PER_WORKSPACE=50
# New versions (write_files, create_app, restores, gallery copies) of one app /
# made by one person within the last hour; then rate_limited, nothing stored:
# VERSIONS_PER_APP_HOUR=600
# VERSIONS_PER_USER_HOUR=1200
# Version history: the newest versions each app keeps (older ones are deleted
# hourly; the published one, the preview's, kept versions and rollback sets
# stay), how many versions of one app its members may keep, the unique bytes
# the versions of one workspace's apps may store (then limit_exceeded) and the
# versions one page of an app's history lists:
# APP_VERSIONS_KEEP=200
# APP_VERSIONS_KEPT_MAX=20
# WORKSPACE_SOURCE_QUOTA=1073741824
# APP_VERSIONS_PAGE=20
# Largest /mcp request body, i.e. one write_files call as JSON (default
# 2 × COMPILE_MAX_TOTAL_BYTES = 10 MiB; bigger → 413 with a JSON-RPC error):
# MCP_MAX_BODY_BYTES=10485760
# MCP sessions (in memory): closed after this long (ms) without a request, and
# a user's least recently used one is closed when they open one past the cap;
# the client gets 404 for the old session id and opens a new session:
# MCP_SESSION_IDLE_TTL_MS=3600000
# MCP_SESSIONS_PER_USER=10
# Largest request body of the dashboard pages, sign-in and OAuth endpoints
# (default 1 MiB; bigger → 413; /mcp, asset uploads and the CSV import keep
# their own limits). The Caddyfile carries the same cap: after a change re-run
# task selfhost:init and task tls:reload:
# DASHBOARD_MAX_BODY_BYTES=1048576
# On a stop (deploy, upgrade, restart) requests in flight get this long (ms) to
# finish before the rest is cut; the compose file's stop_grace_period (30s)
# must stay above it. An error nothing caught stops drobek the same way, exit
# code 1 (Docker restarts it):
# SHUTDOWN_GRACE_MS=20000
# Database: connections per pool (requests; background jobs) — keep
# 2 × DB_POOL_MAX + 5 below Postgres's max_connections (100); a request's
# query is cut off past the statement timeout or a lock wait past the lock
# timeout (0 = none). Background jobs have no statement timeout:
# DB_POOL_MAX=20
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=10000
# Warnings one publish readiness report lists (write_files, publish, app page):
# READINESS_MAX_WARNINGS=50
# Background TypeScript check of app versions (worker threads; 0 workers = off):
# TYPECHECK_WORKERS=1
# TYPECHECK_TIMEOUT_MS=20000
# TYPECHECK_MAX_MEMORY_MB=512
# TYPECHECK_MAX_FILES=150
# End-user sign-in provider callbacks per client IP per 15 min (server-wide):
# AUTH_PROVIDER_CALLBACKS_PER_IP_15MIN=60
# FILES_QUOTA_PER_APP=524288000
# App assets (video, audio, images, fonts at /<path>). ASSETS_DIR is
# fixed by the compose file (/data/assets, the assets_data volume):
# APP_ASSET_MAX_BYTES=104857600
# APP_ASSETS_QUOTA=1073741824
# APP_ASSET_UPLOADS_PER_HOUR=60
# Extra https origins apps may frame, besides YouTube, Vimeo and Google Drive
# (comma- or space-separated https://host[:port]; invalid → the server refuses to start):
# APP_FRAME_SRC_EXTRA=
# One signed-in user (or one visitor IP) per minute, before the per-app limits:
# DATA_WRITES_PER_PRINCIPAL_PER_MIN=60
# Live data subscriptions: open per app / per user or visitor IP, lifetime,
# changes kept per collection for a reconnect:
# DATA_SUBSCRIBE_MAX_PER_APP=200
# DATA_SUBSCRIBE_MAX_PER_CALLER=4
# DATA_SUBSCRIBE_MAX_MS=3600000
# DATA_SUBSCRIBE_BACKLOG=100
# FILES_UPLOADS_PER_PRINCIPAL_PER_MIN=20
# FILES_SWEEP_INTERVAL_MS=3600000
# FILES_SWEEP_RETENTION_MS=86400000
# How often the get_logs retention prune runs (removes rows older than 30 days):
# LOGS_PRUNE_INTERVAL_MS=3600000
# A deleted app is deleted for good this many days after the delete (versions,
# module data, end users, uploads, domains, assets, logs; audit rows stay),
# and how often that purge runs:
# APP_PURGE_AFTER_DAYS=30
# APP_PURGE_INTERVAL_MS=3600000
# Module jobs (scheduled work of the modules; 0 = none on this process),
# runs in flight per process, the longest run (ms):
# MODULE_JOBS_ENABLED=1
# MODULE_JOBS_CONCURRENCY=4
# MODULE_JOBS_TIMEOUT_MS=300000
# A /__drobek/* request body (uploads) must arrive within this many ms (408 past it):
# APPS_MODULE_BODY_TIMEOUT_MS=120000
# EMAIL_GLOBAL_HOURLY_MAX=500
# Proxy calls in flight: the whole server, per app, per caller (user or IP):
# PROXY_MAX_CONCURRENT=32
# PROXY_MAX_CONCURRENT_PER_APP=8
# PROXY_MAX_CONCURRENT_PER_CALLER=2
# A proxied answer: the upstream connect, a buffered answer (or a stream's
# headers); a streamed text/event-stream answer: between two upstream chunks,
# in total, bytes:
# PROXY_CONNECT_TIMEOUT_MS=8000
# PROXY_RESPONSE_TIMEOUT_MS=120000
# PROXY_STREAM_IDLE_TIMEOUT_MS=60000
# PROXY_STREAM_MAX_MS=300000
# PROXY_STREAM_MAX_BYTES=33554432
# Proxy upstreams per workspace, and upstream registrations per workspace per hour:
# UPSTREAMS_MAX_PER_WORKSPACE=20
# UPSTREAM_REGISTRATIONS_PER_HOUR=20
# Scheduled imports (the `sync` module): the shortest interval (minutes), sources
# per app, bytes one run reads, records one run imports, runs per app per hour,
# failed runs before a source pauses, runs by hand of one source per minute:
# SYNC_MIN_INTERVAL_MIN=5
# SYNC_MAX_SOURCES_PER_APP=10
# SYNC_MAX_RESPONSE_BYTES=5242880
# SYNC_MAX_RECORDS_PER_RUN=1000
# SYNC_RUNS_PER_HOUR_PER_APP=60
# SYNC_PAUSE_AFTER_FAILURES=5
# SYNC_NOW_PER_MINUTE=2
# Incoming webhooks (the `webhooks` module): bytes of one delivery (at most
# 1048576), deliveries per app per minute, endpoints per app:
# WEBHOOKS_MAX_BODY_BYTES=262144
# WEBHOOKS_PER_APP_PER_MINUTE=120
# WEBHOOKS_MAX_ENDPOINTS_PER_APP=10

# One workspace's percent of the module e-mail budgets (100 on a single-workspace server):
# EMAIL_WORKSPACE_HOURLY_SHARE=50
